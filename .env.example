# Service token issued by the identity service (never versioned)
SERVICE_TOKEN=
# Alternative: a file that is read again at every sweep, so the secret can be rotated without a restart
SERVICE_TOKEN_FILE=

# Booking service internal endpoint
BOOKING_API_URL=http://booking-api:8083/api/v1/booking

# Scheduler interval in seconds
EXPIRE_EVERY=60

# Purge of the identity service (HU-AUTH-002). Off by default; on, it needs SERVICE_TOKEN or SERVICE_TOKEN_FILE
PURGE_AUTH_ENABLED=false
AUTH_API_URL=http://auth-api:8081/api/v1/auth
PURGE_EVERY=3600
PURGE_BATCH_SIZE=500
PURGE_RUN_TIMEOUT=60

# Settles the order of a reservation when Booking confirms or expires it (HU-CONCESSIONS-004, ADR-045). Off by default; on, it needs
# SERVICE_TOKEN or SERVICE_TOKEN_FILE and the broker login of Concessions (ADR-036). Never commit a real URL with a password.
CONCESSIONS_EVENTS_ENABLED=false
CONCESSIONS_EVENTS_EVERY=5
CONCESSIONS_EVENTS_BATCH_SIZE=100
CONCESSIONS_EVENTS_RUN_TIMEOUT=20
CONCESSIONS_API_URL=http://concessions-api:8085/api/v1/concessions
CONCESSIONS_AMQP_URL=
CONCESSIONS_AMQP_EXCHANGE=cine.events
CONCESSIONS_AMQP_DEAD_LETTER_EXCHANGE=cine.dlx

# Sweep of the orders of Concessions without a reservation whose time ran out (HU-CONCESSIONS-004, ADR-045). Off by default;
# on, it needs SERVICE_TOKEN or SERVICE_TOKEN_FILE and CONCESSIONS_API_URL.
EXPIRE_CONCESSIONS_ORDERS_ENABLED=false
EXPIRE_CONCESSIONS_ORDERS_EVERY=60
EXPIRE_CONCESSIONS_ORDERS_BATCH_SIZE=100
EXPIRE_CONCESSIONS_ORDERS_RUN_TIMEOUT=60

# Outbox relay of Concessions (ADR-019, ADR-045). Off by default; on, it needs RELAY_DATABASE_URL and RELAY_AMQP_URL and the queue of
# Ticketing for cine.concessions.order-confirmed.v1 declared first.
CONCESSIONS_OUTBOX_RELAY_ENABLED=false
CONCESSIONS_OUTBOX_RELAY_EVERY=5
CONCESSIONS_OUTBOX_RELAY_EVENT_TYPES=ConcessionOrderConfirmed
TICKETING_OUTBOX_RELAY_ENABLED=false
TICKETING_OUTBOX_RELAY_EVERY=5
TICKETING_OUTBOX_RELAY_EVENT_TYPES=TicketIssued
