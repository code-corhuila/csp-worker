# Service token issued by the identity service (never versioned)
SERVICE_TOKEN=
# Alternative: a file that is read again at every sweep, so the secret can be rotated without a restart
SERVICE_TOKEN_FILE=

# Booking service internal endpoint
BOOKING_API_URL=http://booking-api:8083/api/v1/booking

# Scheduler interval in seconds
EXPIRE_EVERY=60

# Purge of the identity service (HU-AUTH-002). Off by default; on, it needs SERVICE_TOKEN or SERVICE_TOKEN_FILE
PURGE_AUTH_ENABLED=false
AUTH_API_URL=http://auth-api:8081/api/v1/auth
PURGE_EVERY=3600
PURGE_BATCH_SIZE=500
PURGE_RUN_TIMEOUT=60
